{
  "name": "market-impact-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc -b && vite build",
    "test": "tsx --test src/note-links.test.ts src/cloud-session.test.ts src/research.test.ts src/model.test.ts src/interactions.test.ts src/markdown-import.test.ts && node --test server/providers.test.mjs && node --test cloud/services.test.mjs",
